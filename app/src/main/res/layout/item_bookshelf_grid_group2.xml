<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:scrollbars="none"
    tools:ignore="UnusedAttribute">

    <!-- 修改文件路径：app/src/main/res/layout/item_bookshelf_grid_group2.xml
         改动说明：书架分组文件夹卡片（四宫格封面）玻璃拟态化——圆角半透明卡片 + 细描边 -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <io.legado.app.ui.widget.image.CoverImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:scrollbars="none"
                android:src="@drawable/image_cover_default"
                android:transitionName="img_cover"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="UnusedAttribute,ImageContrastCheck"
                tools:layout_editor_absoluteX="4dp" />

            <!-- 修改文件路径：app/src/main/res/layout/item_bookshelf_grid_group2.xml
                 改动说明：分组封面四宫格——在封面框内透明叠加显示组内前4本书的封面，
                 无自定义封面时生效，由适配器加载组内书籍封面 -->
            <LinearLayout
                android:id="@+id/fl_mosaic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:padding="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
                app:layout_constraintEnd_toEndOf="@+id/iv_cover"
                app:layout_constraintStart_toStartOf="@+id/iv_cover"
                app:layout_constraintTop_toTopOf="@+id/iv_cover">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_mosaic1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/book_name"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/iv_mosaic2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/book_name"
                        android:scaleType="centerCrop" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_mosaic3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/book_name"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/iv_mosaic4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/book_name"
                        android:scaleType="centerCrop" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_cover"
                android:ellipsize="end"
                android:gravity="left|bottom"
                android:includeFontPadding="false"
                android:lines="2"
                android:scrollbars="none"
                android:text="@string/book_name"
                android:textColor="@color/md_dark_primary_text"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:paddingTop="8dp"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
                app:layout_constraintStart_toStartOf="@+id/iv_cover"
                app:layout_constraintEnd_toEndOf="@+id/iv_cover"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <io.legado.app.ui.widget.text.BadgeView
                android:id="@+id/bv_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:includeFontPadding="false"
                android:scrollbars="none"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="RtlHardcoded" />

            <io.legado.app.ui.widget.anima.RotateLoading
                android:id="@+id/rl_loading"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="right"
                android:scrollbars="none"
                android:visibility="invisible"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:loading_width="2dp"
                tools:ignore="RtlHardcoded" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <View
        android:id="@+id/vw_foreground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?android:attr/selectableItemBackground"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>



