<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 修改文件路径：app/src/main/res/values/colors.xml
         改动说明：全局配色改为「玻璃拟态」浅色方案——
         浅灰蓝底 + 半透明白玻璃卡片/顶栏 + 霓虹紫蓝强调色，
         深色对应方案见 values-night/colors.xml，跟随系统 DayNight 自动切换 -->
    <color name="launcher_background">#FF1A2F5A</color>
    <!-- 顶栏/控件主色：95%透明白玻璃（由 85% 加实，提升顶栏文字与弹出菜单对比度） -->
    <color name="primary">#F2FFFFFF</color>
    <color name="primaryDark">#E6E8EFFF</color>
    <!-- 强调色：深靛蓝（由霓虹紫蓝 #FF6558F0 加深，降低荧光感，与纯黑正文更协调） -->
    <color name="accent">#FF4C43D6</color>

    <color name="disabled">@color/md_light_disabled</color>

    <color name="divider">#1A16161E</color>

    <color name="lightBlue_color">#FF578FCC</color>

    <color name="error">#eb4333</color>
    <color name="success">#439b53</color>

    <color name="night_mask">#00000000</color>

    <!-- 窗口背景：冷调浅灰蓝 -->
    <color name="background">#FFF0F1F7</color>
    <!-- 卡片背景：94%透明白玻璃（由 72% 加实，底部导航/卡片上的副文字对比达 WCAG AA） -->
    <color name="background_card">#F0FFFFFF</color>
    <color name="background_menu">#F2FFFFFF</color>
    <!-- 设置页背景：统一到玻璃白（原 50% 透明白偏灰） -->
    <color name="background_prefs">#F2FFFFFF</color>

    <color name="transparent">#00000000</color>

    <color name="transparent10">#10000000</color>
    <color name="transparent20">#20000000</color>
    <color name="transparent30">#30000000</color>
    <color name="transparent50">#50000000</color>

    <color name="highlight">#d3321b</color>

    <color name="btn_bg_press">#63ACACAC</color>
    <color name="btn_bg_press_2">#63858585</color>
    <color name="btn_bg_press_tp">#632C2C2C</color>

    <color name="card_bg_water">#69fdfdfd</color>
    <color name="card_border_water">#39424242</color>

    <!-- 玻璃拟态卡片：底色与描边（深色变体见 values-night）
         底色由 65% 加实到 90%，保留微透感；描边由 12% 加深到 18% 使卡片轮廓可辨 -->
    <color name="glass_card_bg">#E6FFFFFF</color>
    <color name="glass_card_border">#2E16161E</color>

    <!-- 按钮文字：60% 主题黑（原 45% 中性灰，与玻璃底对比不足） -->
    <color name="tv_btn_normal_black">#9916161E</color>
    <color name="tv_btn_press_black">#adadad</color>

    <!-- 修改说明：主文字提亮为不透明近纯黑，副文字提至 70% 不透明，增强与玻璃卡片对比 -->
    <color name="primaryText">#FF16161E</color>
    <color name="secondaryText">#B316161E</color>
    <!-- 摘要/辅助文字：由 54% 灰统一到 70% 主题黑，与 secondaryText 同级（层级靠字号区分） -->
    <color name="tv_text_summary">#B316161E</color>
    <color name="tv_text_book_detail">#dfdfdf</color>
    <!-- 弹出菜单文字：80% 主题黑（原 #383838），色调与正文统一 -->
    <color name="menu_color_default">#CC16161E</color>


    <color name="tv_text_button_nor">#efefef</color>

